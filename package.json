{
  "name": "anyaxml",
  "displayName": "AnyaXML",
  "description": "Format, minify, validate, and preview XML as tables in VS Code.",
  "version": "0.2.2",
  "publisher": "Sanyam",
  "repository": {
    "type": "git",
    "url": "https://github.com/snymkmr/anyaXML.git"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Formatters",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:xml",
    "onCommand:anyaxml.formatXml",
    "onCommand:anyaxml.oneLineXml",
    "onCommand:anyaxml.validateXml",
    "onCommand:anyaxml.previewXmlAsTable"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "anyaxml.formatXml",
        "title": "AnyaXML: Format XML Document"
      },
      {
        "command": "anyaxml.oneLineXml",
        "title": "AnyaXML: Minify XML Document"
      },
      {
        "command": "anyaxml.validateXml",
        "title": "AnyaXML: Validate XML"
      },
      {
        "command": "anyaxml.previewXmlAsTable",
        "title": "AnyaXML: Preview XML as Table"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "anyaxml.formatXml",
          "when": "editorLangId == xml || resourceExtname == .xml || resourceExtname == .xsd || resourceExtname == .xsl || resourceExtname == .xslt",
          "group": "1_modification@1"
        },
        {
          "command": "anyaxml.validateXml",
          "when": "editorLangId == xml || resourceExtname == .xml || resourceExtname == .xsd || resourceExtname == .xsl || resourceExtname == .xslt",
          "group": "1_modification@3"
        },
        {
          "command": "anyaxml.oneLineXml",
          "when": "editorLangId == xml || resourceExtname == .xml || resourceExtname == .xsd || resourceExtname == .xsl || resourceExtname == .xslt",
          "group": "1_modification@2"
        },
        {
          "command": "anyaxml.previewXmlAsTable",
          "when": "editorLangId == xml || resourceExtname == .xml || resourceExtname == .xsd || resourceExtname == .xsl || resourceExtname == .xslt",
          "group": "1_modification@4"
        }
      ],
      "explorer/context": [
        {
          "command": "anyaxml.formatXml",
          "when": "resourceExtname == .xml || resourceExtname == .xsd || resourceExtname == .xsl || resourceExtname == .xslt",
          "group": "2_workspace@1"
        },
        {
          "command": "anyaxml.validateXml",
          "when": "resourceExtname == .xml || resourceExtname == .xsd || resourceExtname == .xsl || resourceExtname == .xslt",
          "group": "2_workspace@3"
        },
        {
          "command": "anyaxml.oneLineXml",
          "when": "resourceExtname == .xml || resourceExtname == .xsd || resourceExtname == .xsl || resourceExtname == .xslt",
          "group": "2_workspace@2"
        },
        {
          "command": "anyaxml.previewXmlAsTable",
          "when": "resourceExtname == .xml || resourceExtname == .xsd || resourceExtname == .xsl || resourceExtname == .xslt",
          "group": "2_workspace@4"
        }
      ]
    },
    "configuration": {
      "title": "AnyaXML",
      "properties": {
        "anyaxml.powershellExecutable": {
          "type": "string",
          "default": "",
          "description": "PowerShell executable used for formatting and minifying XML documents and for validating files over 50 MiB. Leave empty to use pwsh (or powershell.exe on Windows)."
        },
        "anyaxml.validateOnChange": {
          "type": "boolean",
          "default": true,
          "description": "Validate XML after edits. Validation is debounced; disable this for very large documents if it slows editing."
        },
        "anyaxml.validateOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Validate XML when a document is saved."
        }
      }
    }
  },
  "scripts": {
    "test": "npm run compile && node --test",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "sax": "^1.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^5.4.5"
  }
}
